{
  "expo": {
    "name": "TazaNiyet2",
    "slug": "TazaNiyet2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tazaniyet2",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sunsetq.TazaNiyet2"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TazaNiyet использует местоположение, чтобы отметить загрязнённое место и показать задания рядом с вами."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TazaNiyet использует галерею, чтобы прикрепить фото загрязнённого места.",
          "cameraPermission": "TazaNiyet использует камеру, чтобы сфотографировать загрязнённое место и результат уборки.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "701ffb98-93c3-4607-b5d1-503c77378345"
      }
    }
  }
}
